# Copiá este archivo a .streamlit/secrets.toml (local) o pegalo en
# "Settings > Secrets" de tu app en Streamlit Community Cloud.
# NUNCA subas el secrets.toml real a GitHub.

# Elegí el proveedor de IA para la extracción: "anthropic" o "gemini"
PROVIDER = "anthropic"

# Solo hace falta completar la key del proveedor que elegiste arriba.
ANTHROPIC_API_KEY = "sk-ant-..."
GEMINI_API_KEY = ""

APP_PASSWORD = "elegí-una-contraseña-para-el-equipo"
